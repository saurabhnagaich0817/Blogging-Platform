				},
				{
					"name": "Request Role Upgrade",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwtToken}}", "type": "string" }] },
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"Author\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/users/request-upgrade", "host": ["{{baseUrl}}"], "path": ["api", "users", "request-upgrade"] }
					}
				},
				{
					"name": "Approve Upgrade (Admin)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwtToken}}", "type": "string" }] },
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"Author\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/users/:targetUserId/approve-upgrade", "host": ["{{baseUrl}}"], "path": ["api", "users", ":targetUserId", "approve-upgrade"], "variable": [{ "key": "targetUserId", "value": "" }] }
