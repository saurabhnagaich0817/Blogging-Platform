					"name": "Get All Users",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
					}
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/users/profile/:username", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile", ":username"], "variable": [{ "key": "username", "value": "testuser" }] }
