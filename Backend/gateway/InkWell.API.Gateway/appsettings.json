{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "ThisIsASecretKeyForJwtAuthenticationInInkWellPlatformWhichShouldBeLong",
    "Issuer": "InkWellAuthService",
    "Audience": "InkWellClients",
    "ExpireHours": "24"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://inkwell-frontend.netlify.app"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "auth-route-exact": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth"
        }
      },
      "posts-route": {
        "ClusterId": "posts-cluster",
        "Match": {
          "Path": "/api/posts/{**catch-all}"
        }
      },
      "posts-route-exact": {
        "ClusterId": "posts-cluster",
        "Match": {
          "Path": "/api/posts"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "users-route-exact": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users"
        }
      },
      "profile-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      },
      "comments-route": {
        "ClusterId": "comments-cluster",
        "Match": {
          "Path": "/api/comments/{**catch-all}"
        }
      },
      "comments-route-exact": {
        "ClusterId": "comments-cluster",
        "Match": {
          "Path": "/api/comments"
        }
      },
      "categories-route": {
        "ClusterId": "categories-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "categories-route-exact": {
        "ClusterId": "categories-cluster",
        "Match": {
          "Path": "/api/categories"
        }
      },
      "tags-route": {
        "ClusterId": "categories-cluster",
        "Match": {
          "Path": "/api/tags/{**catch-all}"
        }
      },
      "tags-route-exact": {
        "ClusterId": "categories-cluster",
        "Match": {
          "Path": "/api/tags"
        }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/api/media/{**catch-all}"
        }
      },
      "media-route-exact": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/api/media"
        }
      },
      "newsletter-route": {
        "ClusterId": "newsletter-cluster",
        "Match": {
          "Path": "/api/newsletter/{**catch-all}"
        }
      },
      "newsletter-route-exact": {
        "ClusterId": "newsletter-cluster",
        "Match": {
          "Path": "/api/newsletter"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-route-exact": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications"
        }
      },
      "uploads-route": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://auth-service:8080"
          }
        }
      },
      "posts-cluster": {
        "Destinations": {
          "posts-service": {
            "Address": "http://post-service:8080"
          }
        }
      },
      "comments-cluster": {
        "Destinations": {
          "comments-service": {
            "Address": "http://comment-service:8080"
          }
        }
      },
      "categories-cluster": {
        "Destinations": {
          "categories-service": {
            "Address": "http://category-service:8080"
          }
        }
      },
      "media-cluster": {
        "Destinations": {
          "media-service": {
            "Address": "http://media-service:8080"
          }
        }
      },
      "newsletter-cluster": {
        "Destinations": {
          "newsletter-service": {
            "Address": "http://newsletter-service:8080"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-service": {
            "Address": "http://notification-service:8080"
          }
        }
      }
    }
  }
}
