{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "ThisIsASecretKeyForJwtAuthenticationInInkWellPlatformWhichShouldBeLong",
    "Issuer": "InkWellAuthService",
    "Audience": "InkWellClients",
    "ExpireHours": "24"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://inkwell-frontend.netlify.app"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "auth-route-exact": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/auth"
        }
      },
      "posts-route": {
        "ClusterId": "posts_cluster",
        "Match": {
          "Path": "/api/posts/{**catch-all}"
        }
      },
      "posts-route-exact": {
        "ClusterId": "posts_cluster",
        "Match": {
          "Path": "/api/posts"
        }
      },
      "users-route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "users-route-exact": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/users"
        }
      },
      "profile-route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      },
      "comments-route": {
        "ClusterId": "comments_cluster",
        "Match": {
          "Path": "/api/comments/{**catch-all}"
        }
      },
      "comments-route-exact": {
        "ClusterId": "comments_cluster",
        "Match": {
          "Path": "/api/comments"
        }
      },
      "categories-route": {
        "ClusterId": "categories_cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "categories-route-exact": {
        "ClusterId": "categories_cluster",
        "Match": {
          "Path": "/api/categories"
        }
      },
      "tags-route": {
        "ClusterId": "categories_cluster",
        "Match": {
          "Path": "/api/tags/{**catch-all}"
        }
      },
      "tags-route-exact": {
        "ClusterId": "categories_cluster",
        "Match": {
          "Path": "/api/tags"
        }
      },
      "media-route": {
        "ClusterId": "media_cluster",
        "Match": {
          "Path": "/api/media/{**catch-all}"
        }
      },
      "media-route-exact": {
        "ClusterId": "media_cluster",
