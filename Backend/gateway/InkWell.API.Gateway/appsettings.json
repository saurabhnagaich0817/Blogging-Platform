      "notifications-route": {
        "ClusterId": "notifications_cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-route-exact": {
        "ClusterId": "notifications_cluster",
        "Match": {
          "Path": "/api/notifications"
        }
      },
      "uploads-route": {
        "ClusterId": "media_cluster",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_service": {
            "Address": "https://saurabh0817-inkwell-auth-service.hf.space"
